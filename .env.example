# Public PostHog browser configuration. Set both as Environment Variables on Vercel; /api/posthog-config
# serves them to /posthog-init.js.
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host

# 30 minute calls on /contact (api/_calendar.js). Server-only: set on Vercel, never in the page.
# Connect the calendar one of two ways; with neither, the call section stays hidden and the brief
# works as before.
# Either the Apps Script bridge (tools/calendar-bridge.gs, no Google Cloud project needed):
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
GOOGLE_APPS_SCRIPT_SECRET=the_same_long_random_string_as_in_the_script
# Or an OAuth client and refresh token (tools/google-refresh-token.mjs), used when no bridge URL is set:
# GOOGLE_CLIENT_ID=your_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
# Optional. Where bookings go (default primary) and other calendars whose busy times also block
# a slot, comma separated (a work calendar shared with this account, for one).
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_BUSY_CALENDARS=you@work.com
# Optional booking rules, shown with their defaults.
# BOOKING_ZONE=Asia/Kolkata
# BOOKING_HOURS=mon-fri 14:00-24:00
# BOOKING_NOTICE_HOURS=12
# BOOKING_BUFFER_MINUTES=15
# BOOKING_DAYS_AHEAD=14
